{
  "algo_version": "v3",
  "hash": "sha256",
  "recipe": "sha256( canon_repo(url) | ';'.join(sorted set of canon_path(locations[].path)) | primary_cwe )",
  "field_separator": "|",
  "path_separator": ";",
  "rules": {
    "canon_repo": "strip/lower; git@host: -> https://host/ ; ^(https?|ssh|git):// -> https:// ; strip trailing .git ; strip trailing /",
    "canon_path": "strip; backslash->slash; collapse //; lstrip(chars './'); rstrip('/')  [line numbers live in `lines`, never here]",
    "primary_cwe": "first of finding.cwes upper()+strip(); 'CWE-0' when absent/empty",
    "locations": "deduped set of canon paths, sorted, ';'-joined"
  },
  "source": "traust_ledger.api.identity",
  "note": "Regression fixtures for the canonical recipe, ported into this repo on 2026-08-18 from the retired traust-contracts golden-vector suite (plan decision D7: only the harness computes identity, so no second-language port needs a shared oracle). These are NOT a cross-language contract \u2014 they are this implementation's regression net, which D7 explicitly says not to lose. Regenerate with scripts/gen_identity_recipe_vectors.py; v1_expected_fingerprint keeps a recipe move visible rather than silently re-baselined.",
  "vectors": [
    {
      "name": "single_path_with_cwe",
      "why": "baseline: one clean path, upper-case CWE present",
      "input": {
        "repo_url": "https://github.com/org/repo",
        "finding": {
          "locations": [
            {
              "path": "src/app.go"
            }
          ],
          "cwes": [
            "CWE-79"
          ]
        }
      },
      "normalized": {
        "canon_repo": "https://github.com/org/repo",
        "canon_paths_sorted_set": [
          "src/app.go"
        ],
        "primary_cwe": "CWE-79"
      },
      "payload": "https://github.com/org/repo|src/app.go|CWE-79",
      "expected_fingerprint": "1d72674005823cd435bf2978bd586585c5984d9b13b695cd5460f76d4ab0bb2d",
      "v1_expected_fingerprint": "1d72674005823cd435bf2978bd586585c5984d9b13b695cd5460f76d4ab0bb2d",
      "unchanged_from_v1": true,
      "moved_in_v3": false
    },
    {
      "name": "multi_location_sorted_semicolon_join",
      "why": "SCI divergence: paths joined with ';' (not '|') and sorted as a set",
      "input": {
        "repo_url": "https://github.com/org/repo",
        "finding": {
          "locations": [
            {
              "path": "src/b.go"
            },
            {
              "path": "src/a.go"
            }
          ],
          "cwes": [
            "CWE-89"
          ]
        }
      },
      "normalized": {
        "canon_repo": "https://github.com/org/repo",
        "canon_paths_sorted_set": [
          "src/a.go",
          "src/b.go"
        ],
        "primary_cwe": "CWE-89"
      },
      "payload": "https://github.com/org/repo|src/a.go;src/b.go|CWE-89",
      "expected_fingerprint": "97dde2e8d8b05763707b4adc1bbbc9d0fbf773f8c7da3d3da3f3277af58a723c",
      "v1_expected_fingerprint": "97dde2e8d8b05763707b4adc1bbbc9d0fbf773f8c7da3d3da3f3277af58a723c",
      "unchanged_from_v1": true,
      "moved_in_v3": false
    },
